SERVER_PORT=8080
DB_URL=jdbc:mysql://db:3306/${DB_NAME:-library_db}?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=${DB_USERNAME:-library_user}
DB_PASSWORD=${DB_PASSWORD:-library_pass}

APP_JWT_SECRET=${APP_JWT_SECRET:-super_secret_key_change_me_in_production_12345}
APP_CORS_ALLOWED_ORIGINS=http://${HOST_IP:-localhost}:3000,http://${HOST_IP:-localhost}:5173,http://localhost:5173

SPRING_RABBITMQ_HOST=${RABBITMQ_HOST:-rabbitmq}
SPRING_RABBITMQ_PORT=${RABBITMQ_NODE_PORT:-5672}
SPRING_RABBITMQ_USERNAME=${RABBITMQ_DEFAULT_USER:-guest}
SPRING_RABBITMQ_PASSWORD=${RABBITMQ_DEFAULT_PASS:-guest}

ELASTICSEARCH_URIS=http://${ELASTICSEARCH_HOST:-elasticsearch}:9200
